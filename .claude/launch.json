{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Landing Page (docker + nginx)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["run", "--rm", "-p", "3000:80", "-v", "./:/usr/share/nginx/html:ro", "nginx:alpine"],
      "port": 3000
    },
    {
      "name": "Landing Page (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3001", "."],
      "port": 3001
    },
    {
      "name": "Landing Page (python fallback)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    }
  ]
}
